# ============================================
# Variables de Entorno para Vercel
# ============================================
# Copia estos valores y configúralos en:
# Vercel Dashboard → Settings → Environment Variables
#
# IMPORTANTE: No uses este archivo directamente.
# Configura las variables en el dashboard de Vercel.

# ============================================
# API BACKEND (REQUERIDO)
# ============================================
VITE_API_BASE_URL=https://klinia-api-gmdbb0ezfbhybjcw.canadacentral-01.azurewebsites.net/api

# ============================================
# MSAL (Azure AD Authentication) - Opcional
# ============================================
# Solo si usas autenticación con Microsoft
# VITE_MSAL_CLIENT_ID=tu-client-id
# VITE_MSAL_TENANT_ID=tu-tenant-id
# VITE_MSAL_REDIRECT_URI=https://tu-dominio.vercel.app
# VITE_MSAL_POST_LOGOUT_REDIRECT_URI=https://tu-dominio.vercel.app

# ============================================
# METADATOS (Opcional)
# ============================================
# VITE_APP_VERSION=1.0.0
# VITE_VERCEL_ENV=production


