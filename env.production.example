# ============================================
# BreveMente Platform Frontend - Variables de Entorno para Producción
# ============================================
# Copia este archivo a .env.production y completa los valores
# Este archivo se usa cuando ejecutas: npm run build

# ============================================
# API BACKEND
# ============================================
# URL completa del backend en Azure
# Ejemplo: https://brevemente-api.azurewebsites.net/api
# IMPORTANTE: Incluye /api al final si tu backend lo requiere
VITE_API_BASE_URL=https://tu-backend.azurewebsites.net/api

# ============================================
# VERSIÓN Y METADATOS
# ============================================
# Versión de la aplicación (opcional)
VITE_APP_VERSION=1.0.0

# Entorno (production, preview, development)
VITE_VERCEL_ENV=production

# ============================================
# MSAL (Azure AD Authentication) - Opcional
# ============================================
# Si usas autenticación con Azure AD
# VITE_MSAL_CLIENT_ID=tu-client-id
# VITE_MSAL_AUTHORITY=https://login.microsoftonline.com/tenant-id
# VITE_MSAL_REDIRECT_URI=https://tu-dominio.com
# VITE_MSAL_POST_LOGOUT_REDIRECT_URI=https://tu-dominio.com

