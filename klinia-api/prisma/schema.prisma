// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") 
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id 
  email         String    @unique
  name          String
  passwordHash  String
  role          String    @default("PROFESSIONAL")
  createdAt     DateTime  @default(now())

  kycRecord     KycRecord?
  uploads       Upload[]
}

model Upload {
  id           String    @id 
  name         String
  mime         String
  size         Int
  blobName     String
  blobUrl      String
  uploadedAt   DateTime  @default(now())
  userId       String?
  user         User?     @relation(fields: [userId], references: [id])
}

model KycRecord {
  id            String    @id 
  createdAt     DateTime  @default(now())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id])
  identity      Json
  address       Json
  contact       Json
  documents     Json
  face          Json
  verification  Json
}