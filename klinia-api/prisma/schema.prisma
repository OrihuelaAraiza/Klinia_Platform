// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") 
}

generator client {
  provider = "prisma-client-js"
}


// --- 1. MODELOS DE USUARIO Y KYC ---

// Terapeuta / Usuario del Sistema
model User {
  id                    String            @id 
  email                 String            @unique
  name                  String
  passwordHash          String
  role                  String            @default("PROFESSIONAL")
  createdAt             DateTime          @default(now())

  kycRecord             KycRecord?
  patientRecord         PatientRecord?
  uploads               Upload[]

  // Relaciones 1:N
  issuedPrescriptions   Prescription[]    @relation("IssuedPrescriptions")
  sessionsAsProfessional Session[]        @relation("ProfessionalSessions")
  patientsInCharge      PatientRecord[]   @relation("PatientInCharge")
}

model Upload {
  id                    String            @id 
  name                  String
  mime                  String
  size                  Int
  blobName              String
  blobUrl               String
  uploadedAt            DateTime          @default(now())
  userId                String?
  user                  User?             @relation(fields: [userId], references: [id])
}

model KycRecord {
  id                    String            @id
  createdAt             DateTime          @default(now())
  userId                String            @unique
  user                  User              @relation(fields: [userId], references: [id])
  firstName             String
  lastName              String
  curp                  String
  birthDate             String
  certificateFolio      String
  phone                 String
  phoneIsVerified       Boolean           @default(false)
  emergencyName         String
  emergencyPhone        String
  street                String
  neighborhood          String
  postalCode            String
  city                  String
  state                 String
  nombreCoincide        Boolean
  curpCoincide          Boolean
  faceMatch             Boolean           @default(false)
  faceConfidence        String
}


// --- 2. MODELOS DE PACIENTE Y RECETAS ---

// Paciente
model PatientRecord {
  id                    String            @id @default(cuid()) 
  createdAt             DateTime          @default(now())
  userId                String            @unique
  updatedAt             DateTime          @updatedAt
  user                  User              @relation(fields: [userId], references: [id])

  firstName             String
  lastName              String
  curp                  String?
  birthDate             String
  gender                String?
  
  referral              String
  purpose               String
  
  phone                 String
  emergencyName         String
  emergencyPhone        String
  phoneIsVerified       Boolean           @default(false)

  prescriptions         Prescription[]    @relation("PatientPrescriptions")
  sessions              Session[]

 professionalInChargeId String? 
  professionalInCharge   User?   @relation("PatientInCharge", fields: [professionalInChargeId], references: [id])
}

// Recetas
model Prescription {
  id                    String            @id @default(cuid()) 
  
  // METADATOS
  folio                 String            @default(cuid()) // Folio de trazabilidad
  createdAt             DateTime          @default(now())
  status                PrescriptionStatus @default(VIGENTE) // Nuevo campo de estado

  // DATOS RELACIONALES
  therapistId           String
  therapist             User              @relation("IssuedPrescriptions", fields: [therapistId], references: [id])

  patientRecordId       String
  patientRecord         PatientRecord     @relation("PatientPrescriptions", fields: [patientRecordId], references: [id])
  
  substance             String
  form                  String
  dose                  String
  route                 String
  frequency             String
  duration              String
  notes                 String?           // Almacena las indicaciones
}


// --- 3. MODELO DE SESIONES (CORREGIDO) ---

// Sesiones/Citas
model Session {
  id                    String            @id @default(cuid())
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  // RELACIONES
  professionalId        String
  patientId             String
  
  // DATOS DE LA CITA
  datetime              DateTime
  durationMinutes       Int               @default(60)

  modality              Modality
  status                Status

  location              String? 
  notes                 String?

  // FKs
  patient               PatientRecord     @relation(fields: [patientId], references: [id])
  professional          User              @relation("ProfessionalSessions", fields: [professionalId], references: [id])
  
  // Índices para optimizar búsquedas por profesional/paciente y fecha
  @@index([professionalId, datetime])
  @@index([patientId])
}


// --- ENUMS ---
enum Modality {
  IN_PERSON
  TELEMEDICINE
  HOME_VISIT
}

enum Status {
  SCHEDULED
  COMPLETED
  CONFIRMED
  CANCELLED
  NO_SHOW
}


enum PrescriptionStatus {
    VIGENTE
    SUSPENDIDA
}