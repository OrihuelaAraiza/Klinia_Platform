# Identificador de tu App Registration en Azure AD (GUID)
VITE_MSAL_CLIENT_ID=<GUID>

# Tenant usado para la autoridad. Usa 'common' en desarrollo si aún no tienes tenant propio.
VITE_MSAL_TENANT_ID=common

# Opcional: fija la autoridad completa si prefieres no construirla con el tenant.
# VITE_MSAL_AUTHORITY=https://login.microsoftonline.com/<tenant-guid-o-dominio>

# URL de retorno para MSAL (debe coincidir con el redirect registrado en Azure)
VITE_MSAL_REDIRECT_URI=http://localhost:5173

# Base URL del backend mock
VITE_API_BASE_URL=https://klinia-api-gmdbb0ezfbhybjcw.canadacentral-01.azurewebsites.net/api
